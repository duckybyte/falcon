{
    "manifest_version": 3,
    "name": "Falcon Launcher",
    "description": "try to take over the world!",
    "version": "1.0.0",
    "action": {},
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    },
    "permissions": [
        "storage",
        "webNavigation",
        "scripting",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "*://sandbox.moomoo.io/*",
        "http://localhost:8080/*"
    ],
    "content_scripts": [
        {
            "js": [
                "src/remove.js"
            ],
            "matches": [
                "*://sandbox.moomoo.io/*"
            ],
            "all_frames": true,
            "run_at": "document_start"
        }
    ]
}