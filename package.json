{
    "name": "moomoo-falcon-platform",
    "version": "1.0.0",
    "description": "this might be the worse idea in the world",
    "license": "SEE LICENSE in LICENSE",
    "author": "falcon developers",
    "type": "commonjs",
    "main": "index.js",
    "workspaces": [
        "mod-source",
        "falcon-launcher"
    ],
    "scripts": {
        "dev:start": "ts-node backend/index.ts",
        "mod:watch": "npm run watch --workspace=mod-source",
        "mod:build": "npm run build --workspace=mod-source",
        "ext:build": "npm run build --workspace=falcon-launcher",
        "ext:dev": "npm run dev --workspace=falcon-launcher",
        "build": "node packaging/build.mjs",
        "deploy": "npm run mod:build && npm run build && ts-node packaging/deploy.ts",
        "deploy:minor": "npm run deploy -- minor",
        "deploy:major": "npm run deploy -- major",
        "deploy:patch": "npm run deploy -- patch",
        "deploy:current": "npm run deploy -- current"
    },
    "dependencies": {
        "@msgpack/msgpack": "^3.1.3",
        "axios": "^1.18.1",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "path": "^0.12.7"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "ts-node": "^10.9.2"
    },
    "allowScripts": {
        "esbuild@0.27.7": true,
        "fsevents@2.3.3": true
    }
}